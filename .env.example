# Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Security Settings
VITE_ENABLE_MFA=true
VITE_SESSION_TIMEOUT_MINUTES=30
VITE_MAX_LOGIN_ATTEMPTS=5

# VPN/IP Whitelisting (comma-separated IPs or CIDR ranges)
VITE_ALLOWED_IP_RANGES=

# N8N Integration (use http://localhost:5678 for local Docker)
VITE_N8N_WEBHOOK_URL=http://localhost:5678/webhook
VITE_N8N_API_KEY=

# Alexa Smart Home (for future integration)
VITE_ALEXA_CLIENT_ID=
VITE_ALEXA_CLIENT_SECRET=
VITE_ALEXA_REDIRECT_URI=

# App Configuration
VITE_APP_NAME=ALFRED
VITE_APP_VERSION=2.0.0
VITE_ENVIRONMENT=development

# Single User Mode - Only this email can sign in (leave empty for multi-user mode)
VITE_AUTHORIZED_EMAIL=your_email@example.com

# API Endpoints (for future use)
VITE_API_BASE_URL=http://localhost:5000
